  {
   "pair": "T7",
   "source": "tatoeba",
   "group": "deictic",
   "en": "gfh1-cb012c3797bcb308",
   "el": "gfh1-e78e34c309bdee06",
   "enText": "I eat meat three times a week.",
   "elText": "Τρώω κρέας τρείς φορές την εβδομάδα."
