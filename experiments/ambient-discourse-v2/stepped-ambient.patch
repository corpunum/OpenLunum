+/**
+ * Cache-friendly ambient view. The message list (after leading system
+ * messages) is split at a boundary B that moves only in steps:
+ *
+ *   B = floor((n - keepVerbatimLast) / stepMessages) * stepMessages
+ *
+ * Messages before B are planned on their own (keepVerbatimLast 0): their
+ * view depends only on those messages, so it is byte-identical on every
+ * turn until B advances, once per stepMessages new messages. Messages from
+ * B on are verbatim, except that one over recentMaxChars (not the current
+ * turn) is clipped by a plan of that message alone, which is equally stable.
+ * Cost of stability: a unit in the prefix is not dropped as a duplicate of
+ * the same unit in the verbatim tail.
+ */
+export function compactStepped(messages = [], opts = {}) {
+  const t0 = performance.now();
+  const rows = Array.isArray(messages) ? messages : [];
+  let lead = 0;
+  while (lead < rows.length && rows[lead]?.role === 'system') lead += 1;
+  const tail = rows.slice(lead).filter((m) => typeof m?.content === 'string');
+  if (tail.length !== rows.length - lead) return { messages: rows, plan: null, ms: performance.now() - t0 };
+  const cfg = { ...DISCOURSE_CONTEXT_DEFAULTS, ...opts };
+  const step = Math.max(1, Number(cfg.stepMessages) || 1);
+  const boundary = Math.max(0, Math.floor((tail.length - cfg.keepVerbatimLast) / step) * step);
+  let current = -1;
+  for (let i = tail.length - 1; i >= 0; i -= 1) if (tail[i].role === 'user') { current = i; break; }
+  const prefix = boundary > 0 ? compactWithDiscourse(tail.slice(0, boundary), { ...cfg, keepVerbatimLast: 0 }) : null;
+  const stats = { messages: tail.length, boundary, compactedMessages: 0, units: 0, semanticIdentities: 0, dispositions: {} };
+  const add = (plan) => {
+    if (!plan) return;
+    stats.units += plan.stats.units || 0;
+    stats.semanticIdentities += plan.stats.semanticIdentities || 0;
+    for (const [k, v] of Object.entries(plan.stats.dispositions || {})) stats.dispositions[k] = (stats.dispositions[k] || 0) + v;
+  };
+  add(prefix?.plan);
+  const out = [...rows.slice(0, lead)];
+  if (prefix) {
+    for (let i = 0; i < boundary; i += 1) {
+      // The current turn is never inside the prefix (it is the newest user message).
+      const m = prefix.messages[i];
+      if (m.content !== tail[i].content) stats.compactedMessages += 1;
+      out.push(m);
+    }
