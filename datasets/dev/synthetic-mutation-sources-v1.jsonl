{"id": "sharing-es", "semanticGroup": "sharing", "sourceLanguage": "es", "sourceText": "El asistente comparte el documento con el equipo si el archivo pesa menos de 10 MB, a menos que el documento esté marcado como confidencial.", "goldSem": {"schema": "lunum-sem/0.1-draft", "world": "real", "kind": "conditional_instruction", "clauses": [{"predicate": "share", "roles": {"agent": {"type": "actor", "id": "assistant"}, "recipient": {"type": "actor", "id": "team"}, "theme": {"type": "concept", "id": "document"}}, "negated": false, "conditions": [{"predicate": "under", "roles": {"subject": {"type": "metric", "id": "file_size"}, "value": {"type": "quantity", "value": 10, "unit": "MB"}}, "negated": false, "conditions": [{"predicate": "confidential", "roles": {"theme": {"type": "concept", "id": "document"}}, "negated": true}]}]}]}, "protectedLiterals": ["10"], "tags": ["sharing", "es", "synthetic-source"]}
{"id": "sharing-id", "semanticGroup": "sharing", "sourceLanguage": "id", "sourceText": "Asisten membagikan dokumen dengan tim jika berkas di bawah 10 MB, kecuali dokumen ditandai sebagai rahasia.", "goldSem": {"schema": "lunum-sem/0.1-draft", "world": "real", "kind": "conditional_instruction", "clauses": [{"predicate": "share", "roles": {"agent": {"type": "actor", "id": "assistant"}, "recipient": {"type": "actor", "id": "team"}, "theme": {"type": "concept", "id": "document"}}, "negated": false, "conditions": [{"predicate": "under", "roles": {"subject": {"type": "metric", "id": "file_size"}, "value": {"type": "quantity", "value": 10, "unit": "MB"}}, "negated": false, "conditions": [{"predicate": "confidential", "roles": {"theme": {"type": "concept", "id": "document"}}, "negated": true}]}]}]}, "protectedLiterals": ["10"], "tags": ["sharing", "id", "synthetic-source"]}
