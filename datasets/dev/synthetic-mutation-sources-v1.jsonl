{"id":"reminder-en","semanticGroup":"reminder","sourceLanguage":"en","sourceText":"The assistant reminds the user about the meeting if it starts within 1 hour, unless the user has disabled notifications.","goldSem":{"schema":"lunum-sem/0.1-draft","world":"real","kind":"conditional_instruction","clauses":[{"predicate":"remind","roles":{"agent":{"type":"actor","id":"assistant"},"recipient":{"type":"actor","id":"user"},"theme":{"type":"concept","id":"meeting"}},"negated":false,"conditions":[{"predicate":"within","roles":{"subject":{"type":"metric","id":"time_to_meeting"},"value":{"type":"quantity","value":1,"unit":"hour"}},"negated":false,"conditions":[{"predicate":"disabled","roles":{"agent":{"type":"actor","id":"user"},"theme":{"type":"concept","id":"notifications"}},"negated":true}]}]}]},"protectedLiterals":["1"],"tags":["reminder","en","synthetic-source"]}
