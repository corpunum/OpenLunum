{
  "name": "openlunum-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Experimental semantic IR, versioned fingerprints, rendering, and evaluation tooling.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm build && pnpm -r --sort typecheck",
    "test": "pnpm build && pnpm -r --sort test:unit && pnpm test:merge-policy && pnpm test:quality-gate-runner && pnpm test:worker-dispatch && pnpm test:tier2-policy && pnpm test:nightly-window && pnpm test:verify-audit-endpoints && pnpm test:source-only-scoring && pnpm test:client-event-replay && node --test examples/structured-record-demo.test.mjs && pnpm test:license",
    "test:merge-policy": "node --test scripts/pi-merge-policy.test.mjs",
    "test:quality-gate-runner": "node --test scripts/run-quality-gates-ci.test.mjs",
    "test:worker-dispatch": "node --test scripts/pi-dispatch-once.test.mjs",
    "test:tier2-policy": "node --test scripts/agent-eval/run-tier2-policy.test.mjs",
    "test:nightly-window": "node --test scripts/nightly-evidence-runner.test.mjs",
    "test:verify-audit-endpoints": "node --test scripts/verify-audit-endpoints.test.mjs",
    "test:source-only-scoring": "node --test scripts/research/score-natural-source-only-extraction.test.mjs",
    "test:client-event-replay": "node --test scripts/research/replay-client-events.test.mjs",
    "eval:smoke": "pnpm --filter @corpunum/lunum-eval eval:smoke",
    "eval:retention": "pnpm --filter @corpunum/lunum-eval eval:retention",
    "verify": "pnpm typecheck && pnpm test && pnpm eval:smoke",
    "verify:strict": "pnpm build && pnpm -r --sort typecheck && pnpm -r --sort test:unit && pnpm eval:smoke && pnpm --filter @corpunum/lunum-eval verify:strict",
    "agent:status": "pnpm --filter @corpunum/lunum-eval agent:status",
    "worker:dispatch": "bash scripts/pi-dispatch-once.sh",
    "model:doctor": "pnpm --filter @corpunum/lunum-eval model:doctor",
    "experiment:create": "pnpm --filter @corpunum/lunum-eval experiment:create",
    "experiment:run": "pnpm --filter @corpunum/lunum-eval experiment:run",
    "report:generate": "pnpm --filter @corpunum/lunum-eval report:generate",
    "demo:core": "pnpm --filter @corpunum/lunum build && node examples/structured-record-demo.mjs",
    "test:public-demo": "pnpm --filter @corpunum/lunum build && node --test examples/structured-record-demo.test.mjs",
    "test:license": "node --test scripts/license-metadata.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
