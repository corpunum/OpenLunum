{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlunum.org/schemas/lunum-sem/0.2",
  "title": "Lunum-Sem 0.2",
  "description": "Lunum-Sem canonical semantic representation — version 0.2 (frozen)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "world", "kind", "clauses"],
  "properties": {
    "schema": {
      "const": "lunum-sem/0.2"
    },
    "world": {
      "type": "string",
      "minLength": 1,
      "description": "URI identifying the world state this record describes"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Record kind: statement, question, command, etc."
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "description": "Logical clauses composing the semantic record",
      "items": { "$ref": "#/$defs/clause" }
    },
    "references": {
      "type": "array",
      "description": "External references to source text, entities, or other records",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "uri" },
          "type": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Provenance metadata: source, author, timestamp, etc."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional annotations for tooling, scoring, or human review"
    }
  },
  "$defs": {
    "term": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["entity", "quantity", "time", "location", "abstract"] },
            "id": { "type": "string" },
            "value": {},
            "language": { "type": "string", "description": "ISO 639-1 language code" },
            "ref": { "type": "string" }
          }
        }
      ]
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "roles"],
      "properties": {
        "predicate": {
          "type": "string",
          "minLength": 1,
          "description": "Predicate identifying the relation (e.g., located_at, believes, intends)"
        },
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/term" },
          "description": "Role bindings: subject, object, location, etc."
        },
        "negated": {
          "type": "boolean",
          "default": false,
          "description": "Whether this clause is negated"
        },
        "modality": {
          "type": ["string", "null"],
          "enum": ["fact", "belief", "goal", "obligation", "permission", null],
          "description": "Modal status of the clause"
        },
        "time": {},
        "conditions": {
          "type": "array",
          "description": "Conditional antecedents",
          "items": { "$ref": "#/$defs/clause" }
        },
        "consequences": {
          "type": "array",
          "description": "Conditional consequents",
          "items": { "$ref": "#/$defs/clause" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "description": "Clause-level annotations"
        }
      }
    }
  }
}
