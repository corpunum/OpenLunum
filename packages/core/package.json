{
  "name": "@corpunum/lunum",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Lunum-I typed semantic contracts, canonicalization, fingerprints, rendering, policy, and context compilation.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node ../../scripts/generate-sem-transport.mjs --check && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "test:unit": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "license": "Apache-2.0"
}
