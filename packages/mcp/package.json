{
  "name": "@corpunum/lunum-mcp",
  "version": "0.2.0",
  "description": "MCP (Model Context Protocol) server for Lunum semantic content integration",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "lunum-mcp": "./dist/bin/lunum-mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/lunum-mcp.js",
    "dev": "tsx bin/lunum-mcp.ts",
    "test:unit": "node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@corpunum/lunum": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0"
  }
}