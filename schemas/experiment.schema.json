{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlunum.org/schemas/experiment/0.1",
  "title": "OpenLunum experiment 0.1",
  "description": "Experiment manifest schema with cross-references to shared definitions and Lunum-Sem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "area",
    "task",
    "hypothesis",
    "baselineCommit",
    "limits",
    "gates",
    "outputDirectory"
  ],
  "properties": {
    "schema": {
      "const": "openlunum-experiment/0.1"
    },
    "id": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/id"
    },
    "area": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/area"
    },
    "task": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/task"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 10
    },
    "baselineCommit": {
      "type": "string",
      "minLength": 3
    },
    "dataset": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/dataset",
      "description": "Dataset path and hash for model-based tasks"
    },
    "modelProfile": {
      "type": "string",
      "description": "Path to model profile JSON for model-based tasks"
    },
    "targetLanguage": {
      "type": "string"
    },
    "limits": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/limits"
    },
    "gates": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/gates"
    },
    "outputDirectory": {
      "type": "string"
    },
    "deterministic": {
      "type": "boolean",
      "description": "If true, skip model/dataset requirements and run deterministic task"
    },
    "retrievalConfig": {
      "type": "object",
      "description": "Configuration for retrieval tasks",
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "enum": ["exact", "near-semantic"]
        }
      }
    },
    "integrationConfig": {
      "type": "object",
      "description": "Configuration for integration tasks",
      "properties": {
        "selectedIntegration": {
          "type": "string"
        },
        "fixtureId": {
          "type": "string"
        }
      },
      "required": ["selectedIntegration", "fixtureId"]
    }
  }
}
