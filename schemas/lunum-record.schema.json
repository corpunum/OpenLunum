{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlunum.org/schemas/lunum-record/0.1-draft",
  "title": "Lunum Record 0.1 Draft",
  "description": "Lunum record schema with cross-references to Lunum-Sem and shared definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordVersion","source","sem","fingerprint","renderings","policy"],
  "properties":{
    "recordVersion":{"const":"lunum-record/0.1-draft"},
    "source":{"type":"object","required":["text"],"properties":{"text":{"type":"string"},"language":{"type":["string","null"]},"role":{"type":["string","null"]},"ref":{"type":["string","null"]}}},
    "sem":{"$ref":"https://openlunum.org/schemas/lunum-sem/0.1-draft"},
    "fingerprint":{"type":"string","pattern":"^lfp:"},
    "renderings":{"type":"object","additionalProperties":{"type":"object","required":["code","profile"],"properties":{"code":{"type":"string"},"profile":{"type":"string"},"tokens":{"type":["number","null"]}}}},
    "policy":{"type":"object","required":["eligible","risk","confidence"],"properties":{"eligible":{"type":"boolean"},"risk":{"enum":["low","medium","high","unknown"]},"confidence":{"type":"number","minimum":0,"maximum":1},"reasons":{"type":"array","items":{"type":"string"}}}},
    "meta":{"type":"object"}
  }
}
