{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlunum.org/schemas/report-validation/0.1",
  "title": "OpenLunum report validation manifest 0.1",
  "description": "Report validation schema with cross-references to experiment and shared definitions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "area", "task", "hypothesis",
    "baselineCommit", "dataset", "modelProfile",
    "limits", "gates", "outputDirectory"
  ],
  "properties": {
    "$ref": "experiment.schema.json",
    "schema": {
      "const": "openlunum-experiment/0.1"
    },
    "id": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/id"
    },
    "area": {
      "type": "string"
    },
    "task": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/task"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 10
    },
    "baselineCommit": {
      "type": "string",
      "minLength": 3
    },
    "dataset": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/dataset"
    },
    "modelProfile": {
      "type": "string"
    },
    "limits": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/limits"
    },
    "gates": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/gates"
    },
    "outputDirectory": {
      "type": "string"
    }
  }
}
