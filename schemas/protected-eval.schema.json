{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlunum.org/schemas/protected-eval/0.1",
  "title": "OpenLunum protected evaluation manifest 0.1",
  "description": "Protected evaluation manifest schema with cross-references to shared definitions and Lunum-Sem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "datasetId",
    "version",
    "dataset",
    "instructions",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "openlunum-protected-eval/0.1"
    },
    "id": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "datasetId": {
      "type": "string",
      "description": "Immutable identifier for the protected dataset"
    },
    "dataset": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/dataset"
    },
    "instructions": {
      "type": "string",
      "minLength": 10,
      "description": "Evaluator instructions for protected evaluation"
    },
    "coverage": {
      "$ref": "https://openlunum.org/schemas/shared/0.1#/$defs/coverage"
    }
  }
}
