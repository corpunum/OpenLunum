{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlunum.org/schemas/protected-eval/0.1",
  "title": "OpenLunum protected evaluation manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "datasetId",
    "version",
    "dataset",
    "instructions",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "openlunum-protected-eval/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "datasetId": {
      "type": "string",
      "description": "Immutable identifier for the protected dataset"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "license"],
      "properties": {
        "path": {
          "oneOf": [
            { "type": "string", "description": "Absolute path to dataset" },
            { "type": "string", "description": "Environment variable reference (starts with $)" }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "string",
          "description": "License identifier or provenance note"
        },
        "envVar": {
          "type": "string",
          "description": "Environment variable name for path resolution (if path starts with $)"
        }
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 10,
      "description": "Evaluator instructions for protected evaluation"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "languages", "categories"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["parse", "realize", "render", "context", "retrieval", "integration", "conformance", "infrastructure"]
          }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
