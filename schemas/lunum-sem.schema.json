{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://openlunum.org/schemas/lunum-sem/0.1-draft",
  "title":"Lunum-Sem 0.1 Draft",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","world","kind","clauses"],
  "properties":{
    "schema":{"const":"lunum-sem/0.1-draft"},
    "world":{"type":"string","minLength":1},
    "kind":{"type":"string","minLength":1},
    "clauses":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/clause"}},
    "references":{"type":"array","items":{"$ref":"#/$defs/reference"}},
    "provenance":{"type":"object"},
    "annotations":{"type":"object"}
  },
  "$defs":{
    "term":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"object","additionalProperties":true,"required":["type"],"properties":{"type":{"type":"string"},"id":{"type":"string"},"value":{},"language":{"type":"string"},"ref":{"type":"string"}}}]},
    "clause":{"type":"object","additionalProperties":false,"required":["predicate","roles"],"properties":{"predicate":{"type":"string","minLength":1},"roles":{"type":"object","additionalProperties":{"$ref":"#/$defs/term"}},"negated":{"type":"boolean","default":false},"modality":{"$ref":"#/$defs/modality"},"time":{"$ref":"#/$defs/time"},"quantity":{"$ref":"#/$defs/quantity"},"uncertainty":{"$ref":"#/$defs/uncertainty"},"conditions":{"type":"array","items":{"$ref":"#/$defs/clause"}},"consequences":{"type":"array","items":{"$ref":"#/$defs/clause"}},"annotations":{"type":"object"}}},
    "time":{"type":"object","additionalProperties":false,"properties":{
      "type":{"type":"string","enum":["instant","duration","interval"]},
      "value":{},
      "unit":{"type":"string"},
      "precision":{"type":"string", "enum":["exact","approximate","estimated"]}
    }},
    "modality":{"type":"object","additionalProperties":false,"properties":{
      "type":{"type":"string","enum":["epistemic","deontic","alethic","temporal"]},
      "value":{"type":"string", "enum":["necessity","possibility","permission","obligation","prohibition","ability"]}
    }},
    "quantity":{"type":"object","additionalProperties":false,"properties":{
      "value":{"type":"number"},
      "unit":{"type":"string"},
      "precision":{"type":"string", "enum":["exact","approximate","estimated","range"]},
      "range":{"type":"object","properties":{
        "min":{"type":"number"},
        "max":{"type":"number"}
      }}
    }},
    "uncertainty":{"type":"object","additionalProperties":false,"properties":{
      "level":{"type":"string", "enum":["high","medium","low","none"]},
      "type":{"type":"string", "enum":["epistemic","alethic","statistical"]},
      "confidence":{"type":"number", "minimum":0, "maximum":1}
    }},
    "reference":{"type":"object","additionalProperties":false,"properties":{
      "id":{"type":"string"},
      "type":{"type":"string", "enum":["document","section","paragraph","sentence","entity","external"]},
      "value":{},
      "url":{"type":"string"}
    }}
  }
}
