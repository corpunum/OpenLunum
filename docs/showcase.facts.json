{
  "name": "OpenLunum",
  "repo": "corpunum/OpenLunum",
  "oneLiner": "Record what an English sentence states as a small structure a machine can check against its source words, for exact recall and compaction of agent memory.",
  "license": "Apache-2.0",
  "version": "main",
  "updated": "2026-11-12",
  "measured": [
    {
      "metric": "Characters removed by compacting a real agent work log",
      "value": "35%",
      "sample": "one agent session transcript, mean over 24 owner-turn boundaries; compacted / source = 0.649",
      "method": "session-transcript-compaction-v1",
      "date": "2026-10-16",
      "evidence": "experiments/session-transcript-compaction-v1/README.md"
    },
    {
      "metric": "Literal recall, whole history",
      "value": "96.4%",
      "sample": "mean over 24 points; 98.0% of 3,658 literals at the last point",
      "method": "session-transcript-compaction-v1",
      "date": "2026-10-16",
      "evidence": "experiments/session-transcript-compaction-v1/README.md"
    },
    {
      "metric": "Mean prompt tokens of the discourse view vs a head/tail cut",
      "value": "0.561x",
      "sample": "83 held-out sessions, all 292 compaction points",
      "method": "discourse-live-gate-v1",
      "date": "2026-11-11",
      "evidence": "experiments/discourse-live-gate-v1/RESULTS.md"
    },
    {
      "metric": "Fact-recall QA, pooled, prompt only, head/tail cut",
      "value": "20.3%",
      "sample": "83 held-out sessions, 15,949 questions",
      "method": "discourse-live-gate-v1",
      "date": "2026-11-11",
      "evidence": "experiments/discourse-live-gate-v1/RESULTS.md"
    },
    {
      "metric": "Fact-recall QA, pooled, prompt only, discourse view",
      "value": "37.1%",
      "baseline": "20.3%",
      "sample": "83 held-out sessions, 15,949 questions",
      "method": "discourse-live-gate-v1",
      "date": "2026-11-11",
      "evidence": "experiments/discourse-live-gate-v1/RESULTS.md"
    },
    {
      "metric": "English sentences that get a record (Sonnet, frozen contract)",
      "value": "18%",
      "sample": "9 of 50 held-out English sentences",
      "method": "greek-frames-heldout-v1 baseline",
      "date": "2026-10-17",
      "evidence": "experiments/greek-frames-heldout-v1/RESULTS-baseline.md"
    },
    {
      "metric": "English sentences that get a record (Sonnet, frozen contract)",
      "value": "24.5%",
      "sample": "49 of 200 plain English sentences",
      "method": "roundtrip-en-v1 (R4)",
      "date": "2026-10-17",
      "evidence": "experiments/roundtrip-en-v1/RESULTS.md"
    }
  ],
